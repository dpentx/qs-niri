#!/usr/bin/env bash
# Fake `niri msg` for CI: the shell only reads workspaces, keyboard layouts,
# outputs and windows from niri. Anything else is accepted and ignored.
[ "$1" = "msg" ] || exit 0
shift
[ "$1" = "-j" ] && { json=1; shift; }
case "$1" in
  workspaces)
    echo '[{"id":1,"idx":0,"name":null,"output":"HEADLESS-1","is_active":false,"is_focused":false,"active_window_id":null},{"id":2,"idx":1,"name":null,"output":"HEADLESS-1","is_active":true,"is_focused":true,"active_window_id":null},{"id":3,"idx":2,"name":null,"output":"HEADLESS-1","is_active":false,"is_focused":false,"active_window_id":null}]' ;;
  keyboard-layouts)
    echo '{"names":["English (US)","Turkish"],"current_idx":0}' ;;
  outputs)
    echo '{"HEADLESS-1":{"name":"HEADLESS-1","logical":{"x":0,"y":0,"width":1920,"height":1080,"scale":1.0}}}' ;;
  windows)
    echo '[{"id":11,"title":"Mozilla Firefox","app_id":"firefox","pid":1,"workspace_id":2,"is_focused":true,"layout":{"window_size":[900,700]}},{"id":12,"title":"Terminal","app_id":"terminal","pid":2,"workspace_id":2,"is_focused":false,"layout":{"window_size":[900,700]}},{"id":13,"title":"Files","app_id":"files","pid":3,"workspace_id":3,"is_focused":false,"layout":{"window_size":[900,700]}}]' ;;
  focused-window)
    if [ -f /tmp/qs-fakegame ]; then echo '{"id":1,"title":"Elden Ring","app_id":"steam_app_1245620","pid":1,"workspace_id":2,"is_focused":true}'; else echo null; fi ;;
  event-stream)
    exec sleep infinity ;;
  *) exit 0 ;;
esac
