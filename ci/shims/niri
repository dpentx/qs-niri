#!/usr/bin/env bash
# Fake `niri msg` for CI: the shell only reads workspaces, keyboard layouts,
# outputs and windows from niri. Anything else is accepted and ignored.
[ "$1" = "msg" ] || exit 0
shift
[ "$1" = "-j" ] && { json=1; shift; }
case "$1" in
  workspaces)
    echo '[{"id":1,"idx":0,"name":null,"output":"HEADLESS-1","is_active":false,"is_focused":false,"active_window_id":null},{"id":2,"idx":1,"name":null,"output":"HEADLESS-1","is_active":true,"is_focused":true,"active_window_id":null},{"id":3,"idx":2,"name":null,"output":"HEADLESS-1","is_active":false,"is_focused":false,"active_window_id":null}]' ;;
  keyboard-layouts)
    echo '{"names":["English (US)","Turkish"],"current_idx":0}' ;;
  outputs)
    echo '{"HEADLESS-1":{"name":"HEADLESS-1","logical":{"x":0,"y":0,"width":1920,"height":1080,"scale":1.0}}}' ;;
  windows)
    echo '[]' ;;
  event-stream)
    exec sleep infinity ;;
  *) exit 0 ;;
esac
