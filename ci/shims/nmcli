#!/usr/bin/env bash
# Fake nmcli for CI: one connected Wi-Fi network plus two nearby ones.
case "$*" in
  "-t -f DEVICE,TYPE,STATE device")
    # /tmp/qs-nowifi simulates a wired-only machine
    if [ -f /tmp/qs-nowifi ]; then printf 'eth0:ethernet:connected\nlo:loopback:unmanaged\n'
    else printf 'wlan0:wifi:connected\neth0:ethernet:unavailable\nlo:loopback:unmanaged\n'; fi ;;
  "-g NAME connection show --active")
    printf 'Home-WiFi\n'; [ -f /tmp/qs-hotspoton ] && printf 'qs-hotspot\n' ;;
  "-t -f NAME,TYPE,STATE connection show") printf 'Home-WiFi:802-11-wireless:activated\nWork VPN:vpn:activated\n' ;;
  "-t -f NAME,TYPE connection show --active")
    printf 'Home-WiFi:802-11-wireless\n'; [ -f /tmp/qs-hotspoton ] && printf 'qs-hotspot:802-11-wireless\n' ;;
  "-g 802-11-wireless.mode connection show id qs-hotspot") echo ap ;;
  "-g 802-11-wireless.mode connection show id Home-WiFi") echo infrastructure ;;
  "-s -g 802-11-wireless.ssid,802-11-wireless-security.psk connection show id qs-hotspot") printf 'qs-niri\nk7Pq2mXv9a\n' ;;
  "radio wifi") echo enabled ;;
  "m") exec sleep infinity ;;
  "-g NAME connection show") printf 'Home-WiFi\nOffice\n' ;;
  "-g ACTIVE,SIGNAL,FREQ,SSID,BSSID,SECURITY d w")
    printf 'yes:82:5180:Home-WiFi:AA\\:BB\\:CC\\:DD\\:EE\\:01:WPA2\n'
    printf 'no:64:2437:Cafe Guest:AA\\:BB\\:CC\\:DD\\:EE\\:02:WPA2\n'
    printf 'no:41:5240:Neighbour_5G:AA\\:BB\\:CC\\:DD\\:EE\\:03:WPA2\n' ;;
  *) exit 0 ;;
esac
